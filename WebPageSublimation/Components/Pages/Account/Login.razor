@page "/cuenta/ingresar"
@layout AuthLayout
@inject IConfiguration Configuration
@using WebPageSublimation.Features.Auth

<PageTitle>Ingresar | Simons Publicidad</PageTitle>

<section class="login-panel" aria-labelledby="login-title">
    <div class="login-intro">
        <span class="eyebrow">Acceso del equipo</span>
        <h1 id="login-title">Tu trabajo,<br /><em>en orden.</em></h1>
        <p>Consulta el catálogo, prepara proformas y registra pedidos desde un solo lugar.</p>
    </div>

    <form class="login-form" method="post" action="/cuenta/ingresar">
        <AntiforgeryToken />
        @if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        }

        <div class="form-heading">
            <span>SIMONS / SISTEMA</span>
            <h2>Iniciar sesión</h2>
        </div>

        @if (DemoCredentials is not null)
        {
            <section class="demo-access" aria-labelledby="demo-access-title">
                <h3 id="demo-access-title">Usuarios de demostración</h3>
                <p>Elige un rol y usa sus credenciales para probar el sistema.</p>
                <div class="demo-users">
                    @if (!string.IsNullOrWhiteSpace(DemoCredentials.AdministratorEmail))
                    {
                        <article class="demo-user">
                            <h4>Administrador</h4>
                            <dl>
                                <div>
                                    <dt>Usuario</dt>
                                    <dd>@DemoCredentials.AdministratorEmail</dd>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(DemoCredentials.AdministratorPassword))
                                {
                                    <div>
                                        <dt>Contraseña</dt>
                                        <dd><code>@DemoCredentials.AdministratorPassword</code></dd>
                                    </div>
                                }
                            </dl>
                        </article>
                    }
                    <article class="demo-user">
                        <h4>Promotor</h4>
                        <dl>
                            <div>
                                <dt>Usuario</dt>
                                <dd>@DemoCredentials.PromoterEmail</dd>
                            </div>
                            <div>
                                <dt>Contraseña</dt>
                                <dd><code>@DemoCredentials.PromoterPassword</code></dd>
                            </div>
                        </dl>
                    </article>
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="form-alert" role="alert">@Error</div>
        }

        <label for="email">Correo</label>
        <input id="email" name="email" type="email" autocomplete="username" required
               placeholder="nombre@empresa.com" />

        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password"
               required />

        <button type="submit">Entrar al sistema <span aria-hidden="true">→</span></button>
        <p class="form-help">Las cuentas son creadas por el administrador.</p>
    </form>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private DemoLoginCredentials? DemoCredentials { get; set; }

    protected override void OnInitialized() => DemoCredentials = DemoLoginCredentials.From(Configuration);
}
