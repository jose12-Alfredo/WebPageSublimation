@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 class="text-danger">Ocurrió un error.</h1>
<h2 class="text-danger">No fue posible procesar la solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>Identificador de la solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    El entorno <strong>Development</strong> muestra información más detallada sobre el error.
</p>
<p>
    <strong>El entorno de desarrollo no debe habilitarse en una aplicación publicada.</strong>
    Podría mostrar información sensible de las excepciones. Para depurar localmente, establece la
    variable <strong>ASPNETCORE_ENVIRONMENT</strong> en <strong>Development</strong> y reinicia la aplicación.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
