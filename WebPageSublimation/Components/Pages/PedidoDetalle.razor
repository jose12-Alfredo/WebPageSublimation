@page "/pedidos/{Id:guid}"
@attribute [Authorize(Roles = Roles.Administrador + "," + Roles.Promotor)]
@inject PedidoService PedidoService
<PageTitle>Pedido | Simons Publicidad</PageTitle>@if(Detalle is null){<section class="empty-state"><h2>Pedido no disponible</h2><p>No existe o no pertenece a tu cuenta.</p></section>}else{<div class="document-actions"><button onclick="window.print()">Imprimir / guardar PDF</button></div><article class="document"><DocumentCompanyHeader/><header><div><span>SIMONS PUBLICIDAD</span><h1>Pedido #@Detalle.Numero</h1></div><strong>@Format(Detalle.Estado)</strong></header><section class="parties"><div><small>Cliente</small><b>@Detalle.ClienteNombre</b></div><div><small>Promotor</small><b>@Detalle.PromotorNombre</b></div><div><small>Fecha</small><b>@Detalle.FechaUtc.ToString("dd/MM/yyyy")</b></div><div><small>Fecha requerida</small><b>@(Detalle.FechaRequerida?.ToString("dd/MM/yyyy")??"Sin definir")</b></div></section><div class="lines"><div class="line labels"><span>Producto</span><span>Cantidad</span><span>Precio</span><span>Subtotal</span></div>@foreach(var l in Detalle.Lineas){<div class="line"><strong>@l.ProductoNombre@if(!string.IsNullOrWhiteSpace(l.VarianteNombre)){<small>@l.VarianteNombre</small>}@if(!string.IsNullOrWhiteSpace(l.Especificacion)){<small>@l.Especificacion</small>}</strong><span>@l.Cantidad.ToString("0.###")</span><span>@l.PrecioUnitario.ToString("C",Moneda)</span><b>@l.Subtotal.ToString("C",Moneda)</b></div>}<div class="total"><span>Total</span><strong>@Detalle.Total.ToString("C",Moneda)</strong></div></div>@if(!string.IsNullOrWhiteSpace(Detalle.Observaciones)){<section><small>Observaciones</small><p>@Detalle.Observaciones</p></section>}</article>}
@code{private static readonly System.Globalization.CultureInfo Moneda=new("es-BO");[Parameter]public Guid Id{get;set;}[CascadingParameter]private Task<AuthenticationState> Auth{get;set;}=default!;private WebPageSublimation.Features.Pedidos.PedidoDetalle? Detalle;protected override async Task OnParametersSetAsync(){var state=await Auth;Detalle=await PedidoService.ObtenerAsync(state.User,Id);}private static string Format(EstadoPedido value)=>value==EstadoPedido.EnProduccion?"En producción":value.ToString();}

