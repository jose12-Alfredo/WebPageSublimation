@page "/promotor"
@attribute [Authorize(Roles = Roles.Promotor)]
@inject DashboardService DashboardService
<PageTitle>Mi espacio | Simons Publicidad</PageTitle><header class="page-heading"><span>Área comercial</span><h1>Mi actividad</h1><p>Pedidos entregados, trabajos pendientes y proformas recientes de tu cuenta.</p></header>@if(Resumen is not null){<section class="metrics"><article><span>Importe entregado</span><strong>@Resumen.TotalVentas.ToString("C",Moneda)</strong><small>@Resumen.VentasEntregadas pedidos; base para comisión manual</small></article><article><span>Pedidos pendientes</span><strong>@Resumen.PedidosPendientes</strong></article><article><span>Pedidos registrados</span><strong>@Resumen.PedidosPeriodo</strong></article></section><section class="data-card recent-list"><div class="list-heading"><h2>Proformas recientes</h2><a href="/proformas/nueva">Nueva proforma →</a></div>@foreach(var q in Resumen.ProformasRecientes){<a href="/proformas/@q.Id"><span>#@q.Numero · @q.ClienteNombre<small>@q.FechaUtc.ToString("dd/MM/yyyy")</small></span><strong>@q.Total.ToString("C",Moneda)</strong></a>}</section>}
@code{private static readonly System.Globalization.CultureInfo Moneda=new("es-BO");[CascadingParameter]private Task<AuthenticationState> Auth{get;set;}=default!;private DashboardResumen? Resumen;protected override async Task OnInitializedAsync(){var state=await Auth;Resumen=await DashboardService.ObtenerAsync(state.User,false,null,null,null,null);}}

