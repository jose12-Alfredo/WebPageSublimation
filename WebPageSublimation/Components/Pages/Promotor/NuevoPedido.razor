@page "/pedidos/nuevo"
@attribute [Authorize(Roles = Roles.Promotor)]
@inject ClienteService ClientesService
@inject CatalogoService CatalogoService
<PageTitle>Nuevo pedido | Simons Publicidad</PageTitle>
<header class="page-heading"><span>Área comercial / pedidos</span><h1>Pedido directo</h1><p>Los precios se obtienen del catálogo y quedan guardados como historial.</p></header>
@if(!string.IsNullOrWhiteSpace(Mensaje)){<p class="feedback @Tipo">@Mensaje</p>}
@if(Clientes.Count==0||Productos.Count==0){<section class="empty-state"><strong>Datos necesarios</strong><h2>No se puede crear el pedido.</h2><p>@MensajeDatosFaltantes</p></section>}
else{<form class="order-form" method="post" action="/pedidos/crear" data-proforma-form><AntiforgeryToken /><input type="hidden" name="claveIdempotencia" value="@IdempotencyKey" /><section class="data-card"><h2>Cliente y entrega</h2><label>Cliente<select name="clienteId" required><option value="">Selecciona</option>@foreach(var cliente in Clientes){<option value="@cliente.Id">@cliente.Nombre</option>}</select></label><label>Fecha requerida<input type="date" name="fechaRequerida" /></label><label>Observaciones<textarea name="observaciones" maxlength="1500"></textarea></label></section><section class="data-card"><div class="list-heading"><h2>Productos</h2><button type="button" class="secondary-action" data-add-line>Agregar producto</button></div><div data-lines><div class="order-line" data-line><label>Producto<select name="productoId" data-product-select required><option value="">Selecciona</option>@foreach(var p in Productos){<option value="@p.Id">@p.Nombre — @p.PrecioComercial.ToString("C",Moneda)</option>}</select></label><label>Variante<select name="varianteId" data-variant-select><option value="">Sin variante</option>@foreach(var product in Productos){@foreach(var variant in product.Variantes){<option value="@variant.Id" data-product-id="@product.Id">@variant.Nombre</option>}}</select></label><label>Cantidad<input type="number" name="cantidad" min="0.001" step="0.001" required /></label><label>Especificación<input name="especificacion" maxlength="500" placeholder="Color, talla o personalización" /></label><button type="button" data-remove-line aria-label="Quitar">×</button></div></div><button class="primary-action">Crear pedido →</button></section></form><template id="proforma-line-template"><div class="order-line" data-line><label>Producto<select name="productoId" data-product-select required><option value="">Selecciona</option>@foreach(var p in Productos){<option value="@p.Id">@p.Nombre — @p.PrecioComercial.ToString("C",Moneda)</option>}</select></label><label>Variante<select name="varianteId" data-variant-select><option value="">Sin variante</option>@foreach(var product in Productos){@foreach(var variant in product.Variantes){<option value="@variant.Id" data-product-id="@product.Id">@variant.Nombre</option>}}</select></label><label>Cantidad<input type="number" name="cantidad" min="0.001" step="0.001" required /></label><label>Especificación<input name="especificacion" maxlength="500" /></label><button type="button" data-remove-line>×</button></div></template>}
@code{private readonly Guid IdempotencyKey=Guid.NewGuid();private static readonly System.Globalization.CultureInfo Moneda=new("es-BO");[CascadingParameter]private Task<AuthenticationState> Auth{get;set;}=default!;[SupplyParameterFromQuery(Name="mensaje")]public string? Mensaje{get;set;}[SupplyParameterFromQuery(Name="tipo")]public string? Tipo{get;set;}private IReadOnlyList<ClienteResumen> Clientes=[];private IReadOnlyList<ProductoResumen> Productos=[];private bool HayProductosConPrecioReferencial;private string MensajeDatosFaltantes=>Clientes.Count==0?"Necesitas un cliente activo asignado.":HayProductosConPrecioReferencial?"Los productos activos tienen precios referenciales. El administrador debe confirmar al menos un precio comercial antes de crear pedidos.":"El catálogo necesita al menos un producto activo con precio comercial confirmado.";protected override async Task OnInitializedAsync(){var state=await Auth;Clientes=await ClientesService.ListarParaPromotorAsync(state.User);var productosActivos=await CatalogoService.ListarProductosAsync(null,true);HayProductosConPrecioReferencial=productosActivos.Any(x=>x.PrecioEsReferencial);Productos=productosActivos.Where(x=>!x.PrecioEsReferencial).ToList();}}

