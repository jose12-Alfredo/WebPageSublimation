@page "/pedidos"
@attribute [Authorize(Roles = Roles.Promotor)]
@inject PedidoService PedidoService
<PageTitle>Mis pedidos | Simons Publicidad</PageTitle><header class="page-heading"><span>Área comercial</span><h1>Mis pedidos</h1><p>Consulta pedidos directos y pedidos creados desde proformas.</p><a class="primary-action" href="/pedidos/nuevo">Nuevo pedido →</a></header><section class="records">@if(Listado.Count==0){<div class="empty-list"><strong>Aún no hay pedidos.</strong></div>}else{@foreach(var item in Listado){<a href="/pedidos/@item.Id"><div><span>#@item.Numero · @item.FechaUtc.ToString("dd/MM/yyyy")</span><h2>@item.ClienteNombre</h2><p>@Format(item.Estado) · @(item.FechaRequerida is null?"Sin fecha requerida":$"Requerido {item.FechaRequerida:dd/MM/yyyy}")</p></div><strong>@item.Total.ToString("C",Moneda)</strong></a>}}</section>
@code{private static readonly System.Globalization.CultureInfo Moneda=new("es-BO");[CascadingParameter]private Task<AuthenticationState> Auth{get;set;}=default!;private IReadOnlyList<PedidoResumen> Listado=[];protected override async Task OnInitializedAsync(){var state=await Auth;Listado=await PedidoService.ListarAsync(state.User,false);}private static string Format(EstadoPedido value)=>value==EstadoPedido.EnProduccion?"En producción":value.ToString();}
